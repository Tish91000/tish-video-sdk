# Optional default language for TTSBuilder() calls that don't pass language_code
# explicitly. One process can build TTSBuilders for multiple languages -- this
# is just a convenience default, not a hard constraint (see ADR 0007).
TTS_LANGUAGE_CODE=fr

# Path to a voice_packs.json listing every VoicePack (provider x language
# combination) this process might use -- see voice_packs.example.json for the
# expected shape. TTSBuilder(language_code, provider=None) filters this list
# per call: omit provider for the full ordered fallback chain for that
# language, or pass one to pin to it (disabling fallback). All provider
# credentials live inside that JSON file (each entry's own "credentials"
# field) -- there is no ambient-env-var fallback, deliberately, to avoid the
# credential-shadowing bug ADR 0004 fixed in the previous (flat env-var) design.
TTS_VOICE_PACKS_PATH=./voice_packs.json

# Optional. Points at a JSON file listing SubtitlePacks -- per-language
# subtitle config (which MFA acoustic model to align with, default text
# styling) -- see subtitle_packs.example.json for the expected shape. Unset,
# built-in defaults already cover fr/en/es/ta; this only needs to add
# languages or override a pack's model/styling. MFA alignment additionally
# requires a separate Montreal Forced Aligner install -- see the error
# message SubtitleBuilder raises if MFA_ENV_PATH (below) isn't set.
# SUBTITLE_PACKS_PATH=./subtitle_packs.json

# Optional. Root directory of the conda/mamba environment MFA was installed
# into (e.g. via `conda create -n mfa -c conda-forge montreal-forced-aligner`).
# Only needed if you use MFA forced alignment for subtitles.
# MFA_ENV_PATH=/path/to/miniforge3/envs/mfa
